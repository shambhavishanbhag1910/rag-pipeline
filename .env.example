APP_NAME=Enterprise RAG Pipeline
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/v1
API_KEY=
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]

DATABASE_URL=postgresql+asyncpg://rag:rag_password@postgres:5432/ragdb
DATABASE_URL_SYNC=postgresql+psycopg://rag:rag_password@postgres:5432/ragdb

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

LLM_PROVIDER=extractive
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.0
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=40
RRF_K=60
VECTOR_WEIGHT=1.0
KEYWORD_WEIGHT=1.0

CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.93
CACHE_TTL_SECONDS=3600
CACHE_NAMESPACE=default
PROMPT_VERSION=v1

CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
MAX_CONTEXT_CHARS=12000
MAX_UPLOAD_MB=20

RAGAS_ENABLED=true
RAGAS_LLM_MODEL=gpt-4o-mini
RAGAS_EMBEDDING_MODEL=text-embedding-3-small
RAGAS_MAX_CONCURRENCY=4

AUTO_SEED_SYNTHETIC_DATA=false
SYNTHETIC_DATA_PATH=/app/synthetic_data
